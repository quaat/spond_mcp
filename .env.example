# Spond credentials (required for live use; tests use fakes and do not need these).
SPOND_USERNAME=
SPOND_PASSWORD=

# Optional Spond Club id used by spond_list_club_transactions.
SPOND_CLUB_ID=

# Safety policy. Defaults are conservative; flip these to enable side effects.
SPOND_MCP_READ_ONLY=true
SPOND_MCP_ALLOW_MESSAGES=false
SPOND_MCP_ALLOW_ATTENDANCE_CHANGES=false

# Disclosure policy.
# include_raw=true on read tools is rejected unless this is true.
SPOND_MCP_ALLOW_RAW_PAYLOADS=false

# include_contact=true on profile/group/find-person tools is rejected unless
# this is true. Off by default to keep member email/phone out of summaries.
SPOND_MCP_ALLOW_CONTACT_DETAILS=false

# spond_get_event_attendance_report(mode="tempfile") writes XLSX bytes to
# /tmp; metadata-only mode is always available without this flag.
SPOND_MCP_ALLOW_FILE_EXPORTS=false

# Tuning.
SPOND_MCP_MAX_EVENTS=100
SPOND_MCP_TIMEZONE=UTC
SPOND_MCP_CACHE_TTL_SECONDS=60
